# Copy to .env and fill in. Never commit .env.
# Values containing '$' must be wrapped in single quotes.

# Host port the app is published on (pick any free port on your server).
APP_PORT=

# Database (the bundled MySQL container is created with these).
DB_NAME=dickens
DB_USER=dickens
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Long random string for signing session cookies. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Single admin login. Generate the hash with:
#   docker compose run --rm --no-deps app python -m app.hashpw
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=''

# Set true when the app is served over HTTPS (e.g. behind a reverse proxy).
# Leave false for plain http:// on your home network, or login will not stick.
COOKIE_SECURE=false

# Number of reverse proxies in front of the app that set X-Forwarded-* headers (0 = none).
TRUSTED_PROXIES=0

# Maximum size of one photo, in megabytes (phone photos are usually 3-10 MB).
MAX_UPLOAD_MB=25
# Maximum size of one upload request (several photos picked at once), in megabytes.
# If an HTTPS proxy sits in front of the app, its body-size limit must be at least
# this large (nginx: client_max_body_size 200m;) or big uploads fail at the proxy.
MAX_REQUEST_MB=200
# Maximum size of one 3D scan (.glb / .gltf), in megabytes. Keep MAX_REQUEST_MB and
# your proxy's limit at least this large.
MAX_SCAN_MB=100

# Where photos are stored on the host. Leave unset to use a Docker named volume.
# Unraid example: UPLOADS_PATH=/mnt/user/appdata/dickens-village/uploads
#UPLOADS_PATH=

# User/group IDs the app runs as. Unraid's nobody:users is 99:100.
#APP_UID=1000
#APP_GID=1000

GUNICORN_WORKERS=2
# Threads per worker: requests each worker serves at once (slow uploads don't block the site).
GUNICORN_THREADS=4
LOG_LEVEL=INFO
